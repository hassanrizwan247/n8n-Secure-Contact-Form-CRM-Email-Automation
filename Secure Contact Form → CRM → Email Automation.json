    {
      "parameters": {
        "jsCode": "// STEP 4 — Spam & Abuse Protection (Production Ready)\n\n// Disposable / blocked domains\nconst blockedDomains = [\n  \"tempmail.com\",\n  \"scam.com\",\n  \"example.com\"\n];\n\n// Get incoming item\nconst item = $input.first();\nconst email = item.json.email || \"\";\n\n// --- Email domain check ---\nconst emailParts = email.split(\"@\");\nconst domain = emailParts.length === 2 ? emailParts[1] : null;\n\nif (!domain || blockedDomains.includes(domain)) {\n  return [{ ...item.json, blocked: true, reason: \"Disposable or invalid email\" }];\n}\n\n// --- Rate limiting by IP ---\nconst staticData = $getWorkflowStaticData('global');\n\n// Ensure storage exists\nif (!staticData.submissions) {\n  staticData.submissions = {};\n}\n\n// Get IP safely\nconst headers = item.json.headers || {};\nconst ip =\n  headers[\"x-forwarded-for\"] ||\n  headers[\"x-real-ip\"] ||\n  headers[\"cf-connecting-ip\"] ||\n  \"unknown\";\n\n// Time now\nconst now = Date.now();\nconst lastTime = staticData.submissions[ip];\n\n// Block if same IP within 30 seconds\nif (lastTime && now - lastTime < 30_000) {\n  return [{ ...item.json, blocked: true, reason: \"Rate limit exceeded\" }];\n}\n\n// Store timestamp\nstaticData.submissions[ip] = now;\n\n// Passed all checks\nreturn [{ ...item.json, blocked: false }];"
      },
